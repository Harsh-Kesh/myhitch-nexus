# Copy to .env.local for local dev; the same names get set as Railway
# service variables for production. Never commit the filled-in file.

# Supabase (Project Settings -> Data API / Database) — new-format keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Auth0 — see docs/AUTH0_INTEGRATION_STANDARD.md. Headless/ROPG only: no
# @auth0/nextjs-auth0 SDK, no hosted login redirect, so there is no
# AUTH0_SECRET/session-cookie var — Nexus issues its own session, same as
# every other MYHitch platform. Blocked on being registered as an
# Application inside the existing shared MYHitch tenant (not a new tenant).
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_MGMT_CLIENT_ID=
# AUTH0_MGMT_CLIENT_SECRET=
# AUTH0_API_AUDIENCE=
# AUTH0_DB_CONNECTION=

# Social sign-in (FR-6.2.1) — verified directly against each provider's own JWKS in
# socialIdentity.ts, never through Auth0, so a front-end popup is enough; no redirect.
# Google: free, self-serve in Google Cloud Console — not a blocker.
# GOOGLE_OAUTH_CLIENT_ID=
# Apple: requires a paid Apple Developer Program membership (USD 99/year) to generate
# a Services ID + key at all — blocked pending that decision, see DEVELOPMENT-PLAN.md.
# APPLE_SERVICES_ID=
